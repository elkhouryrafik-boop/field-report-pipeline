{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transcripts.schema.json",
  "title": "transcripts.json (stage 3 transcribe - faster-whisper or sidecar backend)",
  "type": "object",
  "required": [
    "status",
    "errors",
    "meta",
    "items",
    "counts"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "$ref": "#/$defs/status"
    },
    "errors": {
      "$ref": "#/$defs/errors"
    },
    "meta": {
      "allOf": [
        {
          "$ref": "#/$defs/meta"
        },
        {
          "type": "object",
          "required": [
            "backend",
            "model",
            "device",
            "compute_type",
            "language",
            "vad_filter",
            "model_load_seconds",
            "total_audio_seconds",
            "wall_seconds"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "enum": [
                "cpu",
                "cuda",
                "none"
              ]
            },
            "compute_type": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "description": "'auto' = detected per note; see items[].language"
            },
            "vad_filter": {
              "type": "boolean"
            },
            "model_load_seconds": {
              "type": "number",
              "minimum": 0
            },
            "total_audio_seconds": {
              "type": "number",
              "minimum": 0
            },
            "wall_seconds": {
              "type": "number",
              "minimum": 0
            },
            "realtime_factor": {
              "type": [
                "number",
                "null"
              ],
              "description": "total_audio_seconds / (wall_seconds - model_load_seconds)"
            },
            "backend": {
              "enum": [
                "faster-whisper",
                "sidecar"
              ]
            }
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "file",
          "abs_path",
          "message_id",
          "ts",
          "sender",
          "status",
          "attempts",
          "text",
          "segments",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "description": "basename, e.g. DOC-0001.opus"
          },
          "abs_path": {
            "type": "string"
          },
          "message_id": {
            "type": "string",
            "pattern": "^M[0-9]{5}$"
          },
          "ts": {
            "type": "string"
          },
          "sender": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_sec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "language_probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "text": {
            "type": "string",
            "description": "empty string ONLY when status != ok"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "start",
                "end",
                "text"
              ],
              "additionalProperties": true,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                },
                "no_speech_prob": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "avg_logprob": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "status": {
            "enum": [
              "ok",
              "empty_audio",
              "failed",
              "skipped"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "retryable": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "duration_sec"
              ]
            }
          }
        ]
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "input_files",
        "ok",
        "empty_audio",
        "failed",
        "skipped"
      ],
      "properties": {
        "input_files": {
          "type": "integer",
          "minimum": 0
        },
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "empty_audio": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "code",
          "message",
          "retryable",
          "attempts"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "stage",
        "site",
        "generated_at",
        "config_sha256",
        "input_counts",
        "output_counts"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "output_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
