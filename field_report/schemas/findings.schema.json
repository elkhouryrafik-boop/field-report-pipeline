{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings.schema.json",
  "title": "findings.json (stage 6 classify: profile-driven categories, stops, assets)",
  "type": "object",
  "required": [
    "status",
    "errors",
    "meta",
    "site",
    "profile",
    "sectors",
    "stops",
    "priorities",
    "overall"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "$ref": "#/$defs/status"
    },
    "errors": {
      "$ref": "#/$defs/errors"
    },
    "meta": {
      "allOf": [
        {
          "$ref": "#/$defs/meta"
        },
        {
          "type": "object",
          "required": [
            "model",
            "prompt_version",
            "clusters_total",
            "clusters_processed",
            "clusters_failed",
            "schema_retries"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "prompt_version": {
              "type": "string"
            },
            "clusters_total": {
              "type": "integer",
              "minimum": 1
            },
            "clusters_processed": {
              "type": "integer",
              "minimum": 0
            },
            "clusters_failed": {
              "type": "integer",
              "minimum": 0
            },
            "schema_retries": {
              "type": "integer",
              "minimum": 0
            },
            "human_reviewed": {
              "type": "boolean",
              "description": "set true only after the stage-6 human checkpoint"
            }
          }
        }
      ]
    },
    "site": {
      "type": "string"
    },
    "sectors": {
      "type": "array",
      "description": "one entry per profile category, ordered by sector_id (= category id); categories nothing was recorded in are kept as checklist rows",
      "items": {
        "$ref": "#/$defs/sector"
      },
      "minItems": 1,
      "maxItems": 24
    },
    "priorities": {
      "type": "array",
      "description": "one row per category; categories with nothing recorded carry an explicit 'N/A: ...' action",
      "items": {
        "type": "object",
        "required": [
          "sector_id",
          "sector_short",
          "asset_ids",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "sector_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "sector_short": {
            "type": "string",
            "minLength": 1
          },
          "asset_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/asset_id"
            }
          },
          "action": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "minItems": 1
    },
    "overall": {
      "type": "object",
      "required": [
        "damage_level",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "damage_level": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "description": "summary banner text rendered under the executive-summary table"
        },
        "override": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "derived",
            "reason",
            "decided_by",
            "at"
          ],
          "description": "A human setting the overall level against the rollup. Recorded rather than silently applied.",
          "properties": {
            "derived": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 20
            },
            "decided_by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            }
          }
        }
      }
    },
    "unassigned_clusters": {
      "type": "array",
      "description": "clusters that produced no asset (e.g. transit photos). Listing here is REQUIRED — silently dropping a cluster is a spec violation.",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "cluster_id": {
            "type": "string",
            "pattern": "^C[0-9]{3}[a-z]?$"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "profile": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "description": "one entry per surviving stop (cluster), in chronological order",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cluster_id",
          "seq",
          "title",
          "asset_ids",
          "photos"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "pattern": "^C[0-9]{3}[a-z]?$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "declared_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 99
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "start_ts": {
            "type": [
              "string",
              "null"
            ]
          },
          "human_verified": {
            "type": "boolean"
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/asset_id"
            }
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transcripts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unclassified": {
      "type": "array",
      "description": "evidence the classifier could not place; never silently dropped, never guessed",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cluster_id",
          "reason"
        ],
        "properties": {
          "cluster_id": {
            "type": "string",
            "pattern": "^C[0-9]{3}[a-z]?$"
          },
          "reason": {
            "type": "string"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ]
    },
    "severity": {
      "type": "string",
      "minLength": 1,
      "description": "a value of the profile's scale, or N/A; checked against the profile in code"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^S([1-9][0-9]?)-[1-9][0-9]*$"
    },
    "sector": {
      "type": "object",
      "required": [
        "sector_id",
        "sector_name",
        "sector_severity",
        "present",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "sector_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "sector_name": {
          "type": "string",
          "minLength": 2
        },
        "sector_severity": {
          "$ref": "#/$defs/severity"
        },
        "present": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          },
          "minItems": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra_tables": {
          "type": "array",
          "description": "optional extra tables per category",
          "items": {
            "type": "object",
            "required": [
              "title",
              "columns",
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "legend": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "heading_level": {
                "enum": [
                  3,
                  null
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "present": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "sector_severity": {
                "const": "N/A"
              },
              "assets": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "severity": {
                      "const": "N/A"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "present": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "assets": {
                "items": {
                  "properties": {
                    "source_evidence": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "severity",
        "finding",
        "quantities",
        "photos",
        "gps",
        "source_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/asset_id"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "finding": {
          "type": "string",
          "minLength": 3,
          "description": "English prose for the 'Finding / quantity' cell; unconfirmed numbers must read '[to be confirmed]'"
        },
        "quantities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          }
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "media filename as it appears in the chat, e.g. DOC-0001.jpg"
          }
        },
        "gps": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "lat",
                "lng"
              ],
              "additionalProperties": false,
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lng": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "source_cluster": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^C[0-9]{3}[a-z]?$"
                },
                "inherited": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "source_evidence": {
          "type": "array",
          "description": "TRACEABILITY GATE: every real (present) asset cites at least one message/transcript/photo ref",
          "items": {
            "type": "object",
            "required": [
              "type",
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "message",
                  "transcript",
                  "photo",
                  "reviewer"
                ]
              },
              "ref": {
                "type": "string",
                "description": "message -> M#####; transcript -> PTT/AUD basename; photo -> IMG basename; general_info -> field key"
              },
              "cluster_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^C[0-9]{3}[a-z]?$"
              },
              "quote": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "short excerpt supporting the finding"
              }
            }
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "map_marker": {
          "type": [
            "string",
            "null"
          ],
          "description": "label for the stop-marker crosswalk table"
        },
        "cluster_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^C[0-9]{3}[a-z]?$"
        },
        "human_verified": {
          "type": "boolean",
          "description": "false = no person reviewed the stop this finding came from"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "description": "why the classifier chose this category and rating"
        }
      }
    },
    "quantity": {
      "type": "object",
      "required": [
        "unit",
        "value",
        "confirmed"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "m",
            "km",
            "m2",
            "m3",
            "m3/h",
            "no",
            "lm",
            "kVA",
            "kW",
            "ton",
            "%",
            "mm",
            "unit",
            "other"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed": {
          "type": "boolean",
          "description": "false => the quantities sheet and report must flag it 'to be confirmed'"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "description cell text for this line in the quantities sheet"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "verbatim": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          }
        },
        {
          "required": [
            "value_text"
          ],
          "properties": {
            "value_text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "code",
          "message",
          "retryable",
          "attempts"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "stage",
        "site",
        "generated_at",
        "config_sha256",
        "input_counts",
        "output_counts"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "output_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}