{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clusters.schema.json",
  "title": "clusters.json (stage 5 cluster — greedy time-window + GPS grouping)",
  "type": "object",
  "required": [
    "status",
    "errors",
    "meta",
    "clusters",
    "counts"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "$ref": "#/$defs/status"
    },
    "errors": {
      "$ref": "#/$defs/errors"
    },
    "meta": {
      "allOf": [
        {
          "$ref": "#/$defs/meta"
        },
        {
          "type": "object",
          "required": [
            "gap_threshold_sec",
            "rule"
          ],
          "properties": {
            "boundary_mode": {
              "enum": [
                "dot",
                "pin_gap"
              ],
              "description": "dot: the export uses the lone-'.' convention, so the dot is the only asset boundary and a pin is a location inside the asset. pin_gap: no dots in the export — a pin or a silence opens a stop."
            },
            "gap_threshold_sec": {
              "type": "integer",
              "minimum": 1,
              "description": "the silence that opens a stop in the mode that ran: ~180 s in pin_gap mode, far wider in dot mode where it is only a guard against a forgotten dot"
            },
            "rule": {
              "type": "string",
              "minLength": 1,
              "description": "the boundary rule that actually ran, in words, for the reviewer reading the artefact"
            }
          }
        }
      ]
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "seq",
          "start_ts",
          "end_ts",
          "boundary_reason",
          "gps",
          "gps_inherited",
          "message_ids",
          "photos",
          "audios",
          "texts",
          "omitted_count",
          "senders"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]{3}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "start_ts": {
            "type": "string"
          },
          "end_ts": {
            "type": "string"
          },
          "boundary_reason": {
            "enum": [
              "first",
              "gap",
              "new_pin",
              "separator"
            ]
          },
          "gps": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "lat",
                  "lng"
                ],
                "additionalProperties": false,
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lng": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                }
              }
            ]
          },
          "gps_message_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^M[0-9]{5}$"
          },
          "gps_points": {
            "type": "array",
            "description": "every pin dropped inside this stop, in order. One asset can be pinned more than once — a road, a network, a building with a detached annex. gps above is the first of these; an empty array means the stop was never pinned and gps, if any, was inherited.",
            "items": {
              "type": "object",
              "required": [
                "lat",
                "lng",
                "message_id",
                "ts"
              ],
              "additionalProperties": false,
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lng": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "message_id": {
                  "type": "string",
                  "pattern": "^M[0-9]{5}$"
                },
                "ts": {
                  "type": "string"
                }
              }
            }
          },
          "gps_inherited": {
            "type": "boolean",
            "description": "true when gps is the last-seen pin from an earlier cluster rather than a pin inside this cluster"
          },
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^M[0-9]{5}$"
            }
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "filename",
                "message_id",
                "ts",
                "exists"
              ],
              "additionalProperties": false,
              "properties": {
                "filename": {
                  "type": "string"
                },
                "message_id": {
                  "type": "string",
                  "pattern": "^M[0-9]{5}$"
                },
                "ts": {
                  "type": "string"
                },
                "exists": {
                  "type": "boolean"
                },
                "pin_message_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^M[0-9]{5}$",
                  "description": "the pin this photo was taken at — the last pin dropped before it inside this stop, matching an entry in gps_points. null when the stop had not been pinned yet. The report caption prints this pin rather than the stop's primary one."
                }
              }
            }
          },
          "audios": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "filename",
                "message_id",
                "ts",
                "exists"
              ],
              "additionalProperties": false,
              "properties": {
                "filename": {
                  "type": "string"
                },
                "message_id": {
                  "type": "string",
                  "pattern": "^M[0-9]{5}$"
                },
                "ts": {
                  "type": "string"
                },
                "exists": {
                  "type": "boolean"
                }
              }
            }
          },
          "texts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "message_id",
                "ts",
                "sender",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "message_id": {
                  "type": "string",
                  "pattern": "^M[0-9]{5}$"
                },
                "ts": {
                  "type": "string"
                },
                "sender": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "omitted_count": {
            "type": "integer",
            "minimum": 0
          },
          "senders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "clusters",
        "messages_in",
        "messages_assigned",
        "messages_unassigned",
        "clusters_with_gps",
        "clusters_without_gps"
      ],
      "properties": {
        "clusters": {
          "type": "integer",
          "minimum": 1
        },
        "messages_in": {
          "type": "integer",
          "minimum": 1
        },
        "messages_assigned": {
          "type": "integer",
          "minimum": 1
        },
        "messages_unassigned": {
          "type": "integer",
          "const": 0,
          "description": "MUST be 0 — every scoped message belongs to exactly one cluster"
        },
        "clusters_with_gps": {
          "type": "integer",
          "minimum": 0
        },
        "clusters_without_gps": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "code",
          "message",
          "retryable",
          "attempts"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "stage",
        "site",
        "generated_at",
        "config_sha256",
        "input_counts",
        "output_counts"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "output_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
